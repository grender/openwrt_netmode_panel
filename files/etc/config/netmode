# Собственный конфиг демона netmoded.
#
# Здесь ПЯТЬ опций и ничего больше. Ни сохранённых сетей, ни выбранного
# upstream: сети — обычные секции wifi-iface в /etc/config/wireless, а
# выбор выводится из disabled и нигде не хранится (ADR-0002, ADR-0003).
#
# Права: 0600. mode — единственное подлинно собственное состояние демона:
# из живой системы его не вывести, «nikki запущен» это следствие режима,
# а не режим.
#
# ВАЖНО: секция ОБЯЗАНА быть именованной — 'main' в кавычках вторым
# токеном. `config main` без имени создаёт АНОНИМНУЮ секцию (@main[0]),
# и весь код (Go и netmode-apply) обращается к ней как netmode.main.*.
# С анонимной секцией `uci get netmode.main.mode` падает с
# "Entry not found", а `uci set netmode.main.mode=...` — с
# "Invalid argument". Поймано на живом роутере: JSON-фикстуры executor
# в тестах не различают именованные и анонимные секции, поэтому весь
# набор тестов проходил, а переключение режима на железе падало
# мгновенно. Проверяется scripts/check-netmode-seed.sh.

config main 'main'
	# nikki | b4 | off
	option mode 'off'

	# Только LAN-адрес. 0.0.0.0 отвергается при старте — это граница
	# безопасности, а не настройка (ADR-0014). Пусто → берётся из
	# network.lan.ipaddr.
	option listen '192.168.9.1'

	# 8080 занят mihomo (docs/recon/raw/25-netstat.txt).
	option port '8088'

	# Путь к токену, а не сам токен: /etc/config/wireless имеет права 644,
	# и мировидимость в этом каталоге зависит от пакета, а не от политики.
	option token_file '/etc/netmoded/token'

	# Адрес подписки провайдера. Пусто — ВАЛИДНОЕ состояние, а не поломка:
	# демон стартует и работает, расписание обновления молчит, панель
	# показывает подсказку вместо кнопки обновления. Пустым это значение и
	# уезжает на роутер: адрес вводит владелец, сид его не выдумывает.
	#
	#   uci set netmode.main.subscription_url='...' && uci commit netmode
	#
	# Это СЕКРЕТ: в строке лежит идентификатор подписки, то есть знающий её
	# ходит через провайдера под вашим именем. Права 0600 здесь поэтому не
	# формальность, а условие: в /etc/config права зависят от пакета, а не от
	# политики (docs/recon/raw/40-etc-config-perms.txt: у wireless и firewall
	# 644), так что deploy.sh --install доводит их до 0600 при каждой
	# установке, а не только при первом сиде.
	#
	# Почему тогда адрес всё-таки в UCI, а не рядом с токеном. Токен демон
	# СОЗДАЁТ сам, владелец его не вводит и не помнит — такому значению место
	# в служебном файле. Адрес подписки владелец ВВОДИТ руками и меняет при
	# смене провайдера — это настройка, и искать её он будет там, где лежат
	# остальные настройки, то есть в uci. Настройка, спрятанная в сайдкар,
	# теряется: её не видно ни в `uci show netmode`, ни в бэкапе sysupgrade.
	option subscription_url ''
