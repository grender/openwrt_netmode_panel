#!/bin/sh
# netmode-bridge — единственное место рискованных глаголов проброса LAN
# в uplink (SPEC §4, слой 2): перезагрузка сети и firewall, установка
# relayd, страховочный стоп relayd, ping-проба адреса.
#
#   netmode-bridge status <порт>       состояние в JSON, без замка
#   netmode-bridge probe <ip> <iface>  жив ли адрес; без замка
#   netmode-bridge install             apk add relayd
#   netmode-bridge apply enable        network reload + firewall reload
#   netmode-bridge apply disable       то же + страховочный стоп relayd
#   netmode-bridge apply access        только firewall reload
#
# <порт> и <iface> — имена, ВЫВЕДЕННЫЕ демоном из живой системы (ADR-0002,
# ADR-0019). Литералов eth1 или phy0.0-sta0 в этом файле нет и не появится:
# имя порта — свойство конкретной коробки, и скрипт, знающий его заранее,
# на чужой сборке молча ткнул бы не туда.
#
# Ни `uci set`, ни `uci commit` здесь нет: конфигурацию пишет демон, скрипт
# её применяет. Зовут его и демон, и человек из ssh — одной и той же строкой:
# последовательность глаголов и замок обязаны быть воспроизводимы снаружи.
#
# ─────────────────────────────────────────────────────────────────────
# КОДЫ ВОЗВРАТА — часть контракта со стороной, которая скрипт вызывает.
# Таблица живёт в ПЯТИ местах, и они обязаны меняться вместе:
#
#   files/usr/local/bin/netmode-bridge        эта шапка
#   internal/executor/executor.go             bridgeSentinels
#   docs/contracts/executor.md                таблица
#   docs/adr/README.md + ADR фазы моста       таблица решения
#   scripts/check-netmode-bridge.sh           сценарии
#
# Синхронность между ними не проверяет никто: ни один гвард не читает
# комментарии (та же оговорка, что у netmode-wifi, — и тот же прецедент,
# когда переименование прошло зелёным через все гварды).
#
#   0 — выполнено (для probe: адрес ОТВЕТИЛ)
#   1 — некорректный аргумент или использование (баг вызывающего)
#   3 — занято: другой процесс держит flock; система НЕ тронута
#   4 — применение не прошло: network reload или firewall reload отказал
#   5 — relayd не остановился после disable (страховочный стоп не помог)
#   7 — нет предусловия (flock / ubus / apk / ping / нет такого порта)
#   8 — probe: адрес НЕ ответил. Это факт, а не отказ, и он нарочно не
#       делит код с 0 и 1: «свободен» — то самое суждение, на котором
#       вчерашний IP-конфликт и строился, и терять его в общем коде нельзя
#   9 — install: apk add relayd не удался
#
# Кода 2 нет намеренно: он занят шеллом под misuse встроенных команд.
# Код 6 не переиспользуется из netmode-apply: там он значит «верификация
# не сошлась», а верификации здесь нет — см. ниже.
# ─────────────────────────────────────────────────────────────────────
#
# СКРИПТ НЕ ИМЕЕТ ПРАВА УТВЕРЖДАТЬ, ЧТО МОСТ РАБОТАЕТ.
#
# Он видит только коды возврата глаголов, а `network reload` возвращает 0
# и при конфигурации, которая никуда не ведёт, — вчерашняя ручная отладка
# именно так и выглядела: reload зелёный, VLAN висит на несуществующем
# порту. Вердикт выносит демон и только он — по наблюдению живой системы:
# интерфейс homelan поднят с нужным адресом, процесс relayd жив (ADR-0002,
# ADR-0025). Поэтому текст успеха — «применение выполнено», а не «проброс
# работает»: строку из logread человек читает как вердикт.
#
# ЗАПРЕЩЕНО НАВСЕГДА (тот же список, что у netmode-wifi, ADR-0025):
#   ubus call network restart
#   /etc/init.d/network restart
# и любые wifi-глаголы — беспроводной части этот скрипт не касается вовсе.
# `network reload` достаточен: netifd сам пересобирает бридж, VLAN'ы и
# интерфейсы по разнице конфигурации, а restart измеренно роняет домашнюю
# точку доступа вместе со станцией.
set -eu

# Диапазоны [a-z] в проверках аргументов ниже обязаны быть ASCII.
LC_ALL=C
export LC_ALL

# ── пути. Их и только их подменяет песочница scripts/check-netmode-bridge.sh ──
LOCK=/var/lock/netmode-bridge.lock
SYSNET=/sys/class/net
FW_INIT=/etc/init.d/firewall
RELAYD_INIT=/etc/init.d/relayd

# Отказ logger не должен уносить с собой применение: под `set -e` ненулевой
# код первой команды составного тела убил бы скрипт до exit с нужным кодом.
log() { logger -t netmode-bridge "$*" 2>/dev/null || true; printf '%s\n' "$*"; }

# err — то же, но в stderr: демон берёт текст ошибки именно оттуда.
err() { logger -t netmode-bridge "$*" 2>/dev/null || true; printf '%s\n' "$*" >&2; }

die_code() { rc=$1; shift; err "ОШИБКА: $*"; exit "$rc"; }
die() { die_code 1 "$*"; }

# Форма сетевого имени: уходит в путь sysfs и в argv ping. Белый список
# ASCII исключает и обход пути точками (проверено отдельно), и имя с
# дефисом в начале, которое ping принял бы за свой ключ.
check_ifname() {
	case "$1" in
		[a-z]*) ;;
		*) die "имя '$1' должно начинаться с латинской строчной буквы" ;;
	esac
	case "$1" in
		*..*) die "имя '$1' содержит '..' — в пути sysfs это выход из каталога" ;;
		*[!a-z0-9._-]*) die "имя '$1' содержит недопустимые символы (разрешены a-z, 0-9, точка, _ и -)" ;;
	esac
}

# ── разбор argv ──
[ $# -ge 1 ] || die "нужен глагол: status|probe|install|apply"
VERB=$1

# ── замок ──
#
# СВОЙ, не общий с netmode-apply и netmode-wifi (ADR-0027): операции не
# делят ресурс, и общий замок делал бы код 3 ложью. Берут его только
# мутирующие глаголы; status и probe — чтения, им замок не положен:
# «посмотреть состояние» не должно ждать чужого применения.
take_lock() {
	command -v flock >/dev/null 2>&1 || die_code 7 "нет flock — без него два одновременных применения оставят сеть в неопределённом состоянии"
	mkdir -p "$(dirname "$LOCK")"
	exec 9>"$LOCK"
	if ! flock -n 9; then
		die_code 3 "применение уже идёт (занят $LOCK)"
	fi
}

case "$VERB" in

status)
	[ $# -eq 2 ] || die "status: нужен ровно один аргумент — имя LAN-порта"
	PORT=$2
	check_ifname "$PORT"
	# Без apk нельзя ответить на «установлен ли relayd», а полуответ хуже
	# отказа: демон принял бы молчание за false и предложил установку там,
	# где ставить нечем.
	command -v apk >/dev/null 2>&1 || die_code 7 "нет apk — не проверить, установлен ли relayd"
	[ -d "$SYSNET/$PORT" ] || die_code 7 "порта $PORT нет в $SYSNET — конфигурация ссылается на несуществующий порт"

	inst=false
	apk info -e relayd >/dev/null 2>&1 && inst=true
	run=false
	pidof relayd >/dev/null 2>&1 && run=true
	# carrier нечитаем, пока интерфейс административно выключен (EINVAL), —
	# для панели это то же «линка нет», а не отказ замера.
	carrier=$(cat "$SYSNET/$PORT/carrier" 2>/dev/null || echo 0)
	case "$carrier" in 0|1) ;; *) carrier=0 ;; esac
	# speed при лежащем линке — «-1» либо нечитаем; оба случая — null:
	# выдумывать нулевую скорость значило бы отдать панели ложное число.
	speed=$(cat "$SYSNET/$PORT/speed" 2>/dev/null || echo '')
	case "$speed" in ''|-*|*[!0-9]*) speed=null ;; esac
	# Счётчик перескоков carrier — главная улика вчерашнего флапа линка;
	# его отсутствие в чужом ядре не отказ, а честное null.
	flaps=$(cat "$SYSNET/$PORT/carrier_changes" 2>/dev/null || echo '')
	case "$flaps" in ''|*[!0-9]*) flaps=null ;; esac

	printf '{"relayd_installed":%s,"relayd_running":%s,"carrier":%s,"speed_mbps":%s,"carrier_changes":%s}\n' \
		"$inst" "$run" "$carrier" "$speed" "$flaps"
	exit 0
	;;

probe)
	[ $# -eq 3 ] || die "probe: нужно два аргумента — ip и интерфейс"
	IP=$2
	DEV=$3
	case "$IP" in
		*[!0-9.]*|'') die "probe: '$IP' не похож на IPv4-адрес" ;;
	esac
	check_ifname "$DEV"
	command -v ping >/dev/null 2>&1 || die_code 7 "нет ping — занятость адреса не проверить"
	# Один пакет и секунда ожидания: проба стоит на пути синхронного отказа
	# демона (409 leg_ip_taken), и держать HTTP-запрос дольше нельзя.
	#
	# Любой ненулевой код ping читается как «не ответил», и это осознанная
	# слепота: busybox ping не отличает кодом «тишину» от «нет такого
	# интерфейса». Интерфейс приходит из живого статуса wwan, так что второй
	# случай — гонка с падением uplink, и её поймает следующий шаг демона.
	if ping -c 1 -W 1 -I "$DEV" "$IP" >/dev/null 2>&1; then
		log "probe: $IP через $DEV ответил"
		exit 0
	fi
	log "probe: $IP через $DEV не ответил"
	exit 8
	;;

install)
	[ $# -eq 1 ] || die "install: аргументов не бывает"
	command -v apk >/dev/null 2>&1 || die_code 7 "нет apk — установить relayd нечем"
	take_lock
	log "установка relayd (apk add)"
	rc=0
	# stderr apk — в переменную, не в файл: причина отказа уходит демону
	# дословно, ведь «не удался» без неё не чинится (нет сети? нет места?
	# нет фида?) — это три разных починки.
	apk_err=$(apk add relayd 2>&1 >/dev/null) || rc=$?
	[ "$rc" -eq 0 ] || die_code 9 "apk add relayd отказал (код $rc): $(printf '%s' "$apk_err" | tr '\n' ' ')"
	log "relayd установлен"
	exit 0
	;;

apply)
	[ $# -eq 2 ] || die "apply: нужен ровно один аргумент — enable|disable|access"
	ACTION=$2
	case "$ACTION" in enable|disable|access) ;; *) die "apply: неизвестное действие '$ACTION'" ;; esac
	take_lock

	# ubus нужен только там, где перечитывается сеть; access трогает один
	# firewall, и требовать для него ubus значило бы отказывать без причины.
	if [ "$ACTION" != "access" ]; then
		command -v ubus >/dev/null 2>&1 || die_code 7 "нет ubus — сеть не перечитать"
		# network reload, НЕ restart: netifd пересобирает бридж и VLAN'ы по
		# разнице конфигурации, а restart измеренно роняет домашнюю точку
		# (ADR-0025). При включении reload заодно поднимает интерфейс relay —
		# процесс relayd запускает netifd через протокольный обработчик,
		# отдельного старта сервиса здесь нет намеренно: два стартёра одного
		# процесса однажды разойдутся.
		log "apply $ACTION: перечитываю сеть (ubus call network reload)"
		rc=0
		ubus call network reload >/dev/null || rc=$?
		[ "$rc" -eq 0 ] || die_code 4 "применение не прошло: 'ubus call network reload' отказал (код $rc); firewall не трогался"
	fi

	[ -x "$FW_INIT" ] || die_code 7 "нет $FW_INIT — правила зон не применить"
	log "apply $ACTION: перечитываю firewall"
	rc=0
	# stderr — в переменную: fw4 объясняет отказ именно там, и без этого
	# текста код 4 не чинится. Штатные предупреждения fw4 при коде 0
	# отбрасываются вместе с переменной.
	fw_err=$("$FW_INIT" reload 2>&1 >/dev/null) || rc=$?
	[ "$rc" -eq 0 ] || die_code 4 "применение не прошло: '$FW_INIT reload' отказал (код $rc): $(printf '%s' "$fw_err" | tr '\n' ' ')"

	if [ "$ACTION" = "disable" ]; then
		# Страховка, не основной путь: интерфейс relay уже удалён из
		# конфигурации, и netifd обязан погасить relayd сам при reload выше.
		# Но повисший relayd продолжил бы мостить сегменты, которых больше
		# нет в конфигурации, — то есть демонтаж был бы ложью. Один
		# страховочный стоп; лестницы из kill'ов нет намеренно (ADR-0025:
		# «грубее» после «не помогло» — обмен доказанного на недоказуемое).
		if pidof relayd >/dev/null 2>&1; then
			log "apply disable: relayd ещё жив после reload — страховочный стоп"
			[ -x "$RELAYD_INIT" ] && "$RELAYD_INIT" stop >/dev/null 2>&1 || true
			sleep 1
			pidof relayd >/dev/null 2>&1 &&
				die_code 5 "relayd не остановился после демонтажа — мост может продолжать работать поверх удалённой конфигурации"
		fi
	fi

	log "применение выполнено: $ACTION"
	exit 0
	;;

*)
	die "неизвестный глагол '$VERB' (ожидается status|probe|install|apply)"
	;;
esac
