#!/bin/sh
# netmode-wifi — единственное место, где применяется конфигурация wireless
# после смены upstream-сети (SPEC §4, слой 2; ADR-0025, ADR-0027).
#
#   netmode-wifi <радио>
#
# <радио> — станционное радио, ВЫВЕДЕННОЕ демоном из живой системы
# (ADR-0019). Литерала radio0 в этом файле нет и не появится: роль радио —
# свойство конкретного устройства, а не константа, и скрипт, знающий имя
# заранее, однажды применит конфигурацию не к тому радио — на чужой сборке
# молча и без единой ошибки.
#
# Ни `uci set`, ни `uci commit` здесь нет: конфигурацию пишет демон, скрипт
# её применяет. Зовут его и демон, и человек из ssh — одной и той же строкой:
# последовательность глаголов и замок обязаны быть воспроизводимы снаружи, а
# не собираться заново по коду демона в момент разбирательства.
#
# ─────────────────────────────────────────────────────────────────────
# КОДЫ ВОЗВРАТА — часть контракта со стороной, которая скрипт вызывает
# (ADR-0027, docs/contracts/executor.md, wifiSentinels в
# internal/executor/executor.go). Таблица живёт в трёх местах и меняется
# во всех сразу.
#
#   0 — применение выполнено: один из глаголов принят и вернул 0
#   1 — некорректный аргумент или использование (баг вызывающего)
#   3 — занято: другой процесс держит flock; система НЕ тронута
#   4 — оба глагола отказали; конфигурация не применялась
#   7 — нет предусловия (отсутствует flock или ubus)
#
# Кода 2 здесь нет намеренно: он традиционно занят шеллом под misuse
# встроенных команд, и свой смысл на него навешивать значит однажды принять
# опечатку в скрипте за осмысленный отказ.
#
# Коды 5 и 6 не переиспользуются из netmode-apply: там они означают
# «сервис не перешёл в нужное состояние» и «верификация не сошлась».
# Сервисов этот скрипт не трогает, верификации в нём нет. Дырка в нумерации
# честнее числа, означающего в двух соседних контрактах разное.
# ─────────────────────────────────────────────────────────────────────
#
# СКРИПТ НЕ ИМЕЕТ ПРАВА УТВЕРЖДАТЬ УСПЕХ ПЕРЕКЛЮЧЕНИЯ.
#
# Он видит только код возврата глагола, а тот лжёт — это измерено, а не
# предположено: `ubus call network.wireless reconf` без предварительного
# `network reload` вернул 0, не изменив ассоциации вовсе
# (docs/recon/apply-verbs.md §6). Значит кода, означающего «станция на новой
# сети», в таблице выше нет и не появится: материала для такого суждения у
# скрипта не существует.
#
# Вердикт выносит демон и только он — по ассоциации, читая живую систему
# (ADR-0002, ADR-0025 §3). Второй судья здесь означал бы два ответа на один
# вопрос, которые обязаны совпадать и однажды разойдутся: панель покажет
# одно, logread другое. Поэтому и текст успеха — «применение выполнено», а
# не «сеть переключена»: строка из logread — второй по частоте источник, по
# которому человек делает вывод об исходе.
#
# ЗАПРЕЩЕНО НАВСЕГДА, и это запрет по измерению, а не по осторожности:
#
#   wifi                     (без подкоманды)
#   wifi reload
#   wifi up / wifi down
#   ubus call network restart
#   /etc/init.d/network restart
#
# Тупой `wifi` целиком роняет ДОМАШНЮЮ точку доступа вместе со станцией.
# Отрицательный контроль замера, docs/recon/apply-verbs.md §8, дословно:
#
#   418.41 idle phy0.0-sta0 grenderNet idhd NONONO false 1 … 230 …
#   418.99 idle phy0.0-sta0 ERR                    false 0 -  NA  …
#
# то есть `ap_up=false`, затем `ap_clients=0` и `connected_time=NA` —
# единственный клиент домашней точки отвалился немедленно. Узкие глаголы на
# том же стенде, в том же прогоне, не уронили её ни разу за шесть применений.
# Отсюда же запрет на «лестницу глаголов»: если узкий не помог, попробовать
# грубее — значит обменять доказанный ущерб на недоказуемую выгоду ровно в
# тот момент, когда мы уже перестали понимать, что происходит с радио.
# Ступеней две (основной → запасной), третьей нет.
#
# Запрет ловится текстом: scripts/check-netmode-wifi.sh грепает копию этого
# файла и требует, чтобы `wifi` встречался только в форме `wifi reconf`.
set -eu

# Диапазоны [a-z] в проверке аргумента ниже обязаны быть ASCII: в чужой
# локали порядок сортировки другой, и в диапазон попадает лишнее.
LC_ALL=C
export LC_ALL

# ── пути. Их и только их подменяет песочница scripts/check-netmode-wifi.sh ──
LOCK=/var/lock/netmode-wifi.lock
WIFI_SBIN=/sbin/wifi

# Отказ logger не должен уносить с собой применение конфигурации.
#
# Под `set -e` ненулевой код первой команды составного тела убивает скрипт
# НЕМЕДЛЕННО — до printf и до exit с нужным кодом. На образе без апплета
# logger команда даёт 127, и `die_code 4` вернул бы демону 1 с пустым
# stderr: демон прочитал бы это как «баг вызывающего», хотя на деле оба
# глагола отказали и конфигурация ждёт чужого применения.
log() { logger -t netmode-wifi "$*" 2>/dev/null || true; printf '%s\n' "$*"; }

# err — то же, что log, но в stderr.
#
# Демон читает stdout и stderr в отдельные буферы, а в текст ошибки берёт
# именно stderr. Аварийные сообщения на stdout до диагностики не долетают
# вовсе. Дубль в syslog остаётся: по ssh диагностику читают через logread.
err() { logger -t netmode-wifi "$*" 2>/dev/null || true; printf '%s\n' "$*" >&2; }

die_code() { rc=$1; shift; err "ОШИБКА: $*"; exit "$rc"; }
die() { die_code 1 "$*"; }

# ── 1. аргумент ──
#
# Ровно один. Отсутствие аргумента НЕ означает «возьми из конфига»: имя
# радио выводится из живой системы, и угадывать его здесь означало бы завести
# в скрипте второй источник правды (ADR-0002).
[ $# -eq 1 ] || die "нужен ровно один аргумент — станционное радио, например: netmode-wifi <радио>"

RADIO=$1

# Форма имени проверяется до всего остального, и не из вкуса к валидации:
# имя уходит внутрь JSON-литерала `{"device":"…"}` и в argv запасного
# глагола. Белый список ASCII делает невозможной как порчу JSON кавычкой,
# так и имя, начинающееся с дефиса, — его запасной глагол принял бы за свой
# ключ и сделал бы не то, о чём просили.
case "$RADIO" in
	[a-z]*) ;;
	*) die "имя радио '$RADIO' должно начинаться с латинской строчной буквы" ;;
esac
case "$RADIO" in
	*[!a-z0-9_-]*) die "имя радио '$RADIO' содержит недопустимые символы (разрешены a-z, 0-9, _ и -)" ;;
esac

# ── 2. предусловия ──
#
# ДО взятия замка, и это не стилистика. Проверь мы наличие flock после
# попытки его взять — «утилиты нет» стало бы неотличимо от «замок занят»,
# а это разные коды с разной судьбой: 7 чинит владелец роутера (доставить
# пакет), 3 не чинит никто, надо просто дождаться чужого применения.
command -v flock >/dev/null 2>&1 || die_code 7 "нет flock — без него два одновременных применения оставят wireless в неопределённом состоянии"
command -v ubus >/dev/null 2>&1 || die_code 7 "нет ubus — основной глагол недоступен, а один запасной узость операции не доказывает"

# ── 3. замок ──
#
# СВОЙ, а не общий с netmode-apply (ADR-0027). Операции не делят ресурс:
# netmode-apply перезапускает сервисы и firewall, netmode-wifi просит netifd
# перечитать wireless. С общим замком владелец, обновляющий подписку, получал
# бы «занято» на переключение сети без всякой причины — то есть код 3 стал бы
# ложью ровно там, где он единственно и нужен.
#
# Защищает он от ВТОРОГО процесса вне демона (ssh, cron, применение при
# загрузке). Два джоба самого демона внахлёст не идут в принципе — их
# сериализует менеджер джобов (ADR-0013, 409 job_busy).
mkdir -p "$(dirname "$LOCK")"
exec 9>"$LOCK"
if ! flock -n 9; then
	die_code 3 "применение уже идёт (занят $LOCK)"
fi

# ── 4. основной глагол ──
#
# Два вызова ОДНОЙ сцепкой и строго в этом порядке. `network reload` — не
# «на всякий случай»: без него netifd не перечитывает UCI, и `reconf`
# вернёт 0, не сделав ничего. Измерено (docs/recon/apply-verbs.md §6):
# 870 строк сэмплера подряд с прежним ssid и прежним адресом после rc=0.
#
# Поэтому же отказ `network reload` прекращает основной глагол немедленно:
# звать `reconf` поверх непрочитанного UCI — это в точности тот тихий
# провал, ради исключения которого reload здесь и стоит.
log "применение конфигурации wireless на радио $RADIO"

why_main=
rc=0
ubus call network reload >/dev/null || rc=$?
if [ "$rc" -ne 0 ]; then
	why_main="основной глагол: 'ubus call network reload' отказал (код $rc), reconf не вызывался"
else
	rc=0
	ubus call network.wireless reconf "{\"device\":\"$RADIO\"}" >/dev/null || rc=$?
	[ "$rc" -eq 0 ] ||
		why_main="основной глагол: 'ubus call network.wireless reconf' для '$RADIO' отказал (код $rc)"
fi

if [ -z "$why_main" ]; then
	log "применение выполнено: узкий глагол принят"
	exit 0
fi

# ── 5. запасной глагол ──
#
# Существует потому, что основной опирается на два вызова ubus, а
# `network.wireless` в чужой сборке может не принять `device` (в замеренной —
# принимает). Отдельный `network reload` ему не нужен: /sbin/wifi зовёт его
# сам — это видно в его листинге (docs/recon/apply-verbs.md §5), а не
# предполагается.
#
# Отсутствие /sbin/wifi — это код 4, а НЕ 7. Предусловие операции (flock,
# ubus) было; запасной глагол необязателен, и его отсутствие означает ровно
# то же, что его отказ: конфигурация не применялась.
err "$why_main"
log "основной глагол не прошёл, пробуем запасной"

[ -x "$WIFI_SBIN" ] ||
	die_code 4 "конфигурация не применялась. $why_main; запасного глагола нет: $WIFI_SBIN отсутствует или не исполняем"

rc=0
"$WIFI_SBIN" reconf "$RADIO" >/dev/null || rc=$?
[ "$rc" -eq 0 ] ||
	die_code 4 "конфигурация не применялась. $why_main; запасной глагол '$WIFI_SBIN reconf $RADIO' тоже отказал (код $rc). Записанное лежит в /etc/config/wireless и уедет в живую систему при ближайшем чужом применении"

log "применение выполнено: запасной глагол принят"
exit 0
