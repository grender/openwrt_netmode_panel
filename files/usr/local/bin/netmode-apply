#!/bin/sh
# netmode-apply — единственное место, где стартуют и останавливаются
# nikki и b4 (SPEC §4, слой 2).
#
#   netmode-apply nikki|b4|off
#   netmode-apply            # взять режим из /etc/config/netmode
#
# Вызывается демоном, вручную из ssh и при загрузке системы. Идемпотентен:
# повторный вызов с тем же аргументом безопасен.
#
# ─────────────────────────────────────────────────────────────────────
# ИНВАРИАНТ: одновременно активен максимум один из nikki / b4.
#
# Переключение — ВСЕГДА полный стоп обоих плюс firewall restart, без
# оптимизаций вида «b4 и так не запущен» (SPEC §4). Оптимизация выглядит
# безобидно ровно до первого случая, когда сервис считался остановленным,
# а его цепочки остались в nftables: трафик молча идёт мимо туннеля, и
# понять это по внешним признакам почти невозможно.
# ─────────────────────────────────────────────────────────────────────
set -eu

LOCK=/var/lock/netmode-apply.lock
STATE_PKG=netmode

# ─────────────────────────────────────────────────────────────────────
# КОДЫ ВОЗВРАТА — часть контракта со стороной, которая скрипт вызывает
# (docs/contracts/executor.md). Демон обязан отличать «занято, повторите»
# от «переключение провалилось» и от «состояние не сошлось»: реакция на них
# разная вплоть до индикации. Различать это парсингом текста нельзя —
# текст меняется свободно, код не меняется без правки контракта.
#
#   0 — режим применён
#   1 — некорректный аргумент или использование (баг вызывающего)
#   3 — занято: другой процесс держит flock
#   4 — firewall не перезапустился (цепочки могли остаться)
#   5 — сервис не перешёл в нужное состояние (start или enable)
#   6 — верификация не сошлась
#   7 — нет предусловия (отсутствует flock)
#
# Кода 2 здесь нет намеренно: он традиционно занят шеллом под misuse
# встроенных команд, и свой смысл на него навешивать значит однажды принять
# опечатку в скрипте за осмысленный отказ.
# ─────────────────────────────────────────────────────────────────────

# Отказ logger не должен уносить с собой переключение режима.
#
# Под `set -e` ненулевой код первой команды составного тела убивает скрипт
# НЕМЕДЛЕННО — до printf и до exit с нужным кодом. То есть без `|| true`
# весь контракт кодов возврата держался бы на том, что logger не подведёт:
# на образе без busybox-апплета logger команда даёт 127, и `die_code 4`
# возвращал бы демону 1 с пустым stdout и пустым stderr. Демон прочитал бы
# это как «баг вызывающего, система не тронута», хотя оба сервиса уже
# остановлены, а nftables в неизвестном состоянии.
log() { logger -t netmode-apply "$*" 2>/dev/null || true; printf '%s\n' "$*"; }

# err — то же, что log, но в stderr.
#
# Демон читает stdout и stderr в отдельные буферы, а в текст ошибки берёт
# именно stderr. Аварийные сообщения на stdout до диагностики не долетали
# вовсе — ошибка приходила с пустым пояснением. Дублирование в syslog
# остаётся: по ssh диагностику читают через logread.
err() { logger -t netmode-apply "$*" 2>/dev/null || true; printf '%s\n' "$*" >&2; }

die_code() { rc=$1; shift; err "ОШИБКА: $*"; exit "$rc"; }
die() { die_code 1 "$*"; }

# ── аргумент ──

MODE=${1:-}
if [ -z "$MODE" ]; then
	MODE=$(uci -q get "$STATE_PKG".main.mode || echo off)
fi

case "$MODE" in
	nikki|b4|off) ;;
	*) die "неизвестный режим '$MODE' (допустимы nikki, b4, off)" ;;
esac

# ── блокировка ──
#
# Демон и человек из ssh могут запустить скрипт одновременно; два
# одновременных переключения оставили бы систему в состоянии, которого
# не хотел ни один из них.
command -v flock >/dev/null 2>&1 || die_code 7 "нет flock — без него два одновременных переключения оставят систему в неопределённом состоянии"

mkdir -p "$(dirname "$LOCK")"
exec 9>"$LOCK"
# Отсутствие flock проверено выше отдельно: иначе «command not found»
# был бы неотличим от «замок занят», и диагностика увела бы не туда.
# Поэтому и коды разные: 7 — чинит владелец роутера (доставить пакет),
# 3 — не чинит никто, надо просто дождаться чужого переключения.
if ! flock -n 9; then
	die_code 3 "переключение уже идёт (занят $LOCK)"
fi

# ── вспомогательное ──

svc() {
	name=$1; action=$2
	[ -x "/etc/init.d/$name" ] || { log "сервиса $name нет, пропуск"; return 0; }
	# Ошибку стопа глотаем: сервис мог быть уже остановлен, и это не повод
	# прерывать переключение. Ошибку старта — нет.
	if [ "$action" = stop ] || [ "$action" = disable ]; then
		"/etc/init.d/$name" "$action" >/dev/null 2>&1 || true
	else
		# Сообщение пишется ЗДЕСЬ, а не только у вызывающего: без него отказ
		# start/enable выглядел бы как молчаливый ненулевой код, и в logread
		# не осталось бы даже имени сервиса. В stderr — по той же причине,
		# что и die_code: до текста ошибки демона доходит только он.
		if ! "/etc/init.d/$name" "$action"; then
			err "сервис $name: действие $action завершилось ошибкой"
			return 1
		fi
	fi
	return 0
}

running() {
	[ -x "/etc/init.d/$1" ] || return 1
	"/etc/init.d/$1" running >/dev/null 2>&1
}

log "переключение в режим $MODE"

# ── 1. полный стоп обоих ──
#
# Безусловно, даже если сервис «и так не запущен».
svc nikki stop
svc b4 stop

# ── 2. firewall restart ──
#
# Обязателен между стопом и стартом: он вычищает цепочки, оставленные
# остановленными сервисами. Без него в nftables остаются висячие правила,
# и следующий режим работает поверх чужих.
#
# Отказ здесь ОСТАНАВЛИВАЕТ переключение — до шага 3, то есть до старта
# целевого сервиса. Стартовать туннель поверх невычищенных цепочек нельзя:
# это ровно тот сценарий тихого обхода, ради которого firewall restart
# вообще стоит в середине. Шаг 5 такого не поймал бы — он проверяет только
# running() сервисов, а висячее правило в nftables проверкой процессов не
# видно. Проглоченная ошибка давала бы «как бы туннель»: сервис поднят,
# панель зелёная, трафик идёт мимо.
#
# Состояние после этого отказа безопасно и честно: оба сервиса остановлены
# (шаг 1 отработал), автозапуск не переписан, трафик идёт напрямую. Плохо,
# но видно.
#
# Одна повторная попытка. Это НЕ откат (ADR-0006): ничего не возвращается
# в прежнее состояние, повторяется ровно та же операция, которая уже
# началась, — ради случая, когда fw4 не поделил nftables с кем-то ещё в эту
# самую секунду. Повтор живёт здесь, а не в демоне: тут он локален, виден
# в логе одной строкой и не превращается в «демон чинит систему сам»
# (ADR-0010).
#
# Остаточные цепочки НЕ проверяются через `nft list ruleset`: имена цепочек
# nikki и b4 разведкой не подтверждены (docs/recon/), а выдуманное имя — это
# та самая галлюцинированная интеграция, против которой стоит check-evidence.
# Такая проверка начинается с разведки на живом роутере, а не с догадки.
log "перезапуск firewall"
if ! /etc/init.d/firewall restart >/dev/null 2>&1; then
	log "firewall restart не удался, повтор через 1 с"
	sleep 1
	/etc/init.d/firewall restart >/dev/null 2>&1 ||
		die_code 4 "firewall не перезапустился (две попытки); в nftables могли остаться цепочки остановленных сервисов, поэтому целевой сервис не запускался. Оба сервиса остановлены"
fi

# ── 3. старт целевого ──

case "$MODE" in
	nikki)
		svc nikki start || die_code 5 "nikki не запустился"
		;;
	b4)
		svc b4 start || die_code 5 "b4 не запустился"
		;;
	off)
		# Ничего не запускаем: трафик идёт напрямую.
		;;
esac

# ── 4. автозапуск ──
#
# Чтобы режим пережил перезагрузку без участия демона.
#
# Результат enable проверяется явно. Без проверки под `set -eu` голый
# `svc nikki enable` при провале убивал скрипт МОЛЧА: выход происходил бы
# мимо die_code (значит, без внятного текста и без кода причины) и мимо
# шага 5. Отказ enable — это «после перезагрузки режим будет не тот», и
# узнать об этом надо сейчас, а не через перезагрузку.
#
# Код 5 общий со стартом сознательно: для демона это один класс — сервис
# не перешёл в нужное состояние. ЧТО именно не вышло, различает текст,
# который уходит в stderr и попадает в текст ошибки демона целиком.
#
# disable намеренно не проверяется: у него ветка `|| true` в svc(), потому
# что «сервис и так выключен» — не повод валить переключение.
case "$MODE" in
	nikki)
		svc nikki enable || die_code 5 "nikki запущен, но автозапуск (enable) не включился: после перезагрузки режим не восстановится"
		svc b4 disable
		;;
	b4)
		svc b4 enable || die_code 5 "b4 запущен, но автозапуск (enable) не включился: после перезагрузки режим не восстановится"
		svc nikki disable
		;;
	off)
		svc nikki disable
		svc b4 disable
		;;
esac

# ── 5. проверка ──
#
# Скрипт обязан завершиться неуспехом, если получилось не то, о чём
# просили: молчаливый «успех» с незапущенным сервисом хуже явной ошибки.
case "$MODE" in
	nikki)
		running nikki || die_code 6 "nikki должен работать, но не работает"
		running b4 && die_code 6 "b4 должен быть остановлен, но работает"
		;;
	b4)
		running b4 || die_code 6 "b4 должен работать, но не работает"
		running nikki && die_code 6 "nikki должен быть остановлен, но работает"
		;;
	off)
		running nikki && die_code 6 "nikki должен быть остановлен, но работает"
		running b4 && die_code 6 "b4 должен быть остановлен, но работает"
		;;
esac

log "режим $MODE применён"
exit 0
